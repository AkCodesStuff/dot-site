# Canonical origin for canonical URLs, Open Graph tags, sitemap.xml and
# robots.txt. No trailing slash.
#
# Optional. If this is unset, blank, or not a valid absolute URL, the app
# falls back automatically (see src/lib/site-url.ts): Vercel's own per-
# deployment URL if present, otherwise http://localhost:<port> in
# development, otherwise the production domain. Set this only when you need
# to override that — typically to pin the real custom production domain.
NEXT_PUBLIC_SITE_URL=https://www.dot-logistics.com
